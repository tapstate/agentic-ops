{
  "version": 3,
  "rules": [
    {
      "scope": "station-root",
      "pattern": "source",
      "type": "directory",
      "action": "preserve"
    },
    {
      "scope": "station-root",
      "pattern": "runtime",
      "type": "directory",
      "action": "preserve"
    },
    {
      "scope": "station-root",
      "pattern": ".agenticops",
      "type": "directory",
      "action": "preserve"
    },
    {
      "scope": "station-root",
      "pattern": "config",
      "type": "directory",
      "action": "preserve"
    },
    {
      "scope": "station-root",
      "pattern": "archive",
      "type": "directory",
      "action": "preserve"
    },
    {
      "scope": "station-root",
      "pattern": ".idea",
      "type": "directory",
      "action": "preserve"
    },
    {
      "scope": "configuration",
      "pattern": "*",
      "type": "file",
      "action": "configuration"
    },
    {
      "scope": "configuration",
      "pattern": "*",
      "type": "directory",
      "action": "configuration"
    },
    {
      "scope": "station-root",
      "pattern": ".DS_Store",
      "type": "file",
      "action": "generated"
    },
    {
      "scope": "configuration",
      "pattern": ".DS_Store",
      "type": "file",
      "action": "generated"
    },
    {
      "scope": "runtime",
      "pattern": "*",
      "type": "file",
      "action": "generated"
    },
    {
      "scope": "runtime",
      "pattern": "*",
      "type": "directory",
      "action": "generated"
    }
  ]
}
