{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-ops.local/schemas/maintainer/offline-integration-manifest-v1.json",
  "title": "AgenticOps 离线合同回归输入清单",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "issue_key",
    "adapter",
    "agentic_ops",
    "task_repository",
    "agent",
    "jira",
    "verification",
    "cleanup",
    "credential_channels",
    "allowed_external_capabilities",
    "confirmation"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "issue_key": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*-[1-9][0-9]*$" },
    "adapter": { "const": "offline_fake" },
    "agentic_ops": { "$ref": "#/$defs/sourceRepository" },
    "task_repository": { "$ref": "#/$defs/taskRepository" },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_id", "project_profile"],
      "properties": {
        "agent_id": { "type": "string", "pattern": "^[0-9A-Za-z_-]+$" },
        "project_profile": { "type": "string", "pattern": "^[0-9A-Za-z_-]+$" }
      }
    },
    "jira": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_key", "allowed_reads", "allowed_writes"],
      "properties": {
        "project_key": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "allowed_reads": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["identity", "project", "fields", "issue", "comment", "worklog"] }
        },
        "allowed_writes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["comment", "description", "worklog", "transition"] }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commands"],
      "properties": {
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["recipe", "args"],
            "properties": {
              "recipe": { "enum": ["python_unittest", "shell_script", "executable"] },
              "args": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy"],
      "properties": { "strategy": { "const": "always" } }
    },
    "credential_channels": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "jira_api_token_stdin",
          "jira_api_token_hidden_prompt",
          "git_ssh_agent",
          "github_cli_session"
        ]
      }
    },
    "allowed_external_capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "local_filesystem",
          "local_git",
          "loopback_http",
          "subprocess",
          "network_git",
          "network_jira",
          "ssh_agent",
          "github_cli_session"
        ]
      }
    },
    "confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confirmed_by", "confirmed_at", "authorization_reference", "confirmed_manifest_sha256"],
      "properties": {
        "confirmed_by": { "type": "string", "minLength": 1 },
        "confirmed_at": { "type": "string", "format": "date-time" },
        "authorization_reference": { "type": "string", "minLength": 1 },
        "confirmed_manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  },
  "$defs": {
    "sourceRepository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "ref"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "ref": { "type": "string", "minLength": 1 }
      }
    },
    "taskRepository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "slug", "ref"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "slug": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "ref": { "type": "string", "minLength": 1 }
      }
    }
  }
}
