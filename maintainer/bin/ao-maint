#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)"
SOURCE_ROOT="$(CDPATH= cd -- "$SCRIPT_DIR/../.." && pwd -P)"
PYTHON_BIN="$SOURCE_ROOT/maintainer/.venv/bin/python"

if [ ! -x "$PYTHON_BIN" ]; then
  printf 'AgenticOps：维护 Runtime 尚未准备，请执行 uv sync --locked --project maintainer\n' >&2
  exit 1
fi

unset PYTHONPATH
export PYTHONPATH="$SOURCE_ROOT/maintainer/runtime/src"
exec "$PYTHON_BIN" -m ao_maint --source-root "$SOURCE_ROOT" "$@"
