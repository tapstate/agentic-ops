{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenticops.tapstate.local/schemas/step-result-v2.schema.json",
  "title": "AgenticOps StepResult v2",
  "description": "跨 maintainer 与 developer 工作面的纯输出协议；不定义角色、授权或副作用能力。",
  "type": "object",
  "required": ["schema_version", "ok", "operation", "status", "retry_safe", "result", "next_step"],
  "properties": {
    "schema_version": {"const": "step-result/v2"},
    "ok": {"type": "boolean"},
    "operation": {"type": "string", "minLength": 1},
    "status": {"type": "string", "minLength": 1},
    "retry_safe": {"type": "boolean"},
    "result": {
      "type": "object",
      "required": ["status", "summary", "facts", "evidence", "effects", "remaining"],
      "properties": {
        "status": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "facts": {"type": "object"},
        "evidence": {"type": "array"},
        "effects": {"type": "array", "items": {"$ref": "#/$defs/effect"}},
        "remaining": {"type": "array"}
      },
      "additionalProperties": false
    },
    "next_step": {"$ref": "#/$defs/step"}
  },
  "$defs": {
    "effect": {
      "type": "object",
      "required": ["kind", "target", "state", "evidence"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 1},
        "state": {"enum": ["verified", "failed", "uncertain"]},
        "evidence": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "step": {
      "type": "object",
      "required": ["kind", "scope", "mode", "executor", "action", "call"],
      "properties": {
        "kind": {"enum": ["action", "decision", "input", "wait", "none"]},
        "scope": {"enum": ["local", "flow"]},
        "mode": {"enum": ["auto", "timed_auto", "manual"]},
        "executor": {"enum": ["ao_work", "ao_maint", "ai", "human", "reviewer", "project_tool", "stop"]},
        "action": {"type": "string", "minLength": 1},
        "call": {"type": ["object", "null"]}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "none"}}},
          "then": {"properties": {"executor": {"const": "stop"}, "mode": {"const": "manual"}, "call": {"const": null}}}
        },
        {
          "if": {"properties": {"kind": {"const": "decision"}}},
          "then": {"required": ["question", "choices", "submit"]}
        },
        {
          "if": {"properties": {"mode": {"const": "timed_auto"}}},
          "then": {"required": ["timed", "transitions"]}
        }
      ],
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
