{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-ops.local/schemas/shared/integration/task-to-pr-result.schema.json",
  "title": "任务到 PR 审查脱敏结果包",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol",
    "status",
    "delivery_passed",
    "manifest_sha256",
    "generated_at",
    "facts",
    "timeline",
    "human_interventions",
    "waitings",
    "failures",
    "quality_findings",
    "retrospective",
    "prohibitions",
    "next_action",
    "result_sha256"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "protocol": { "const": "task_to_pr_review" },
    "status": { "enum": ["ready_for_pr_review", "blocked", "failed"] },
    "delivery_passed": { "type": "boolean" },
    "manifest_sha256": { "$ref": "#/$defs/sha256" },
    "generated_at": { "type": "string", "format": "date-time" },
    "facts": { "$ref": "#/$defs/facts" },
    "timeline": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/journal_envelope" }
    },
    "human_interventions": {
      "type": "array",
      "items": { "$ref": "#/$defs/human_intervention_envelope" }
    },
    "waitings": {
      "type": "array",
      "items": { "$ref": "#/$defs/waiting_envelope" }
    },
    "failures": {
      "type": "array",
      "items": { "$ref": "#/$defs/failure_envelope" }
    },
    "quality_findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/quality_finding_envelope" }
    },
    "retrospective": { "$ref": "#/$defs/retrospective_envelope" },
    "prohibitions": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": { "$ref": "#/$defs/prohibition_envelope" }
    },
    "next_action": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "result_sha256": {
      "allOf": [
        { "$ref": "#/$defs/sha256" },
        {
          "description": "将 result_sha256 置空后对整个结果包的 canonical JSON 计算所得 SHA-256。"
        }
      ]
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jira_readback",
        "remote_branch_readback",
        "pr_readback",
        "verifications",
        "external_actions"
      ],
      "properties": {
        "jira_readback": {
          "oneOf": [
            { "$ref": "task-to-pr-event.schema.json#/$defs/jira_readback" },
            { "type": "null" }
          ]
        },
        "remote_branch_readback": {
          "oneOf": [
            { "$ref": "task-to-pr-event.schema.json#/$defs/remote_branch_readback" },
            { "type": "null" }
          ]
        },
        "pr_readback": {
          "oneOf": [
            { "$ref": "task-to-pr-event.schema.json#/$defs/pr_readback" },
            { "type": "null" }
          ]
        },
        "verifications": {
          "type": "array",
          "items": {
            "$ref": "task-to-pr-event.schema.json#/$defs/verification"
          }
        },
        "external_actions": {
          "type": "array",
          "items": {
            "$ref": "task-to-pr-event.schema.json#/$defs/external_action"
          }
        },
        "ci_completion": {
          "oneOf": [
            { "$ref": "#/$defs/ci_completion" },
            { "type": "null" }
          ]
        }
      }
    },
    "ci_completion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider", "head_sha", "attempt_id", "ci_status", "ci_requirement", "started_at",
        "execution_started_at", "finished_at", "start_deadline_at", "completion_deadline_at", "required_checks", "workflow_runs",
        "artifact", "report", "remediations", "remediation_attempts_used",
        "remediation_attempts_remaining"
      ],
      "properties": {
        "provider": { "const": "github-actions" },
        "head_sha": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
        "attempt_id": { "type": "string", "pattern": "^[0-9a-f]{24}$" },
        "ci_status": { "enum": ["passed", "not_required"] },
        "ci_requirement": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "source", "base_sha", "reason", "workflow_files"],
          "properties": {
            "status": { "enum": ["required", "not_required"] },
            "source": { "const": "github_pr" },
            "base_sha": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
            "reason": {
              "enum": [
                "base_has_no_github_actions_workflows",
                "configured_workflows_trigger_for_pr_head",
                "configured_workflows_do_not_trigger_for_pr_head"
              ]
            },
            "workflow_files": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["path", "blob_sha", "name", "triggers", "head_trigger"],
                "properties": {
                  "path": { "type": "string", "pattern": "^\\.github/workflows/[^/]+\\.ya?ml$" },
                  "blob_sha": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
                  "name": { "type": "string", "minLength": 1 },
                  "triggers": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
                  "head_trigger": { "type": "boolean" }
                }
              }
            }
          }
        },
        "started_at": { "type": "string", "format": "date-time" },
        "execution_started_at": { "type": ["string", "null"], "format": "date-time" },
        "finished_at": { "type": "string", "format": "date-time" },
        "start_deadline_at": { "type": ["string", "null"], "format": "date-time" },
        "completion_deadline_at": { "type": ["string", "null"], "format": "date-time" },
        "required_checks": { "type": "array", "items": { "type": "object" } },
        "workflow_runs": { "type": "array", "items": { "type": "object" } },
        "artifact": { "type": ["object", "null"] },
        "report": { "type": ["object", "null"] },
        "remediations": { "type": "array", "items": { "type": "object" } },
        "remediation_attempts_used": { "type": "integer", "minimum": 0, "maximum": 3 },
        "remediation_attempts_remaining": { "type": "integer", "minimum": 0, "maximum": 3 }
      },
      "allOf": [
        {
          "if": { "properties": { "ci_status": { "const": "passed" } }, "required": ["ci_status"] },
          "then": {
            "properties": {
              "ci_requirement": { "properties": { "status": { "const": "required" } } },
              "execution_started_at": { "type": "string", "format": "date-time" },
              "start_deadline_at": { "type": "string", "format": "date-time" },
              "completion_deadline_at": { "type": "string", "format": "date-time" },
              "required_checks": { "minItems": 1 }
            }
          },
          "else": {
            "properties": {
              "ci_requirement": { "properties": { "status": { "const": "not_required" } } },
              "execution_started_at": { "type": "null" },
              "start_deadline_at": { "type": "null" },
              "completion_deadline_at": { "type": "null" },
              "required_checks": { "maxItems": 0 },
              "workflow_runs": { "maxItems": 0 },
              "artifact": { "type": "null" },
              "report": { "type": "null" },
              "remediations": { "maxItems": 0 },
              "remediation_attempts_used": { "const": 0 }
            }
          }
        }
      ]
    },
    "journal_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "previous_event_sha256",
        "event_sha256",
        "event"
      ],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1 },
        "previous_event_sha256": {
          "oneOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        },
        "event_sha256": { "$ref": "#/$defs/sha256" },
        "event": { "$ref": "task-to-pr-event.schema.json" }
      }
    },
    "human_intervention_envelope": {
      "allOf": [
        { "$ref": "#/$defs/journal_envelope" },
        {
          "properties": {
            "event": {
              "properties": { "action": { "const": "human_intervention" } }
            }
          }
        }
      ]
    },
    "failure_envelope": {
      "allOf": [
        { "$ref": "#/$defs/journal_envelope" },
        {
          "properties": {
            "event": { "properties": { "action": { "const": "failure" } } }
          }
        }
      ]
    },
    "waiting_envelope": {
      "allOf": [
        { "$ref": "#/$defs/journal_envelope" },
        {
          "properties": {
            "event": { "properties": { "action": { "const": "waiting" } } }
          }
        }
      ]
    },
    "quality_finding_envelope": {
      "allOf": [
        { "$ref": "#/$defs/journal_envelope" },
        {
          "properties": {
            "event": {
              "properties": { "action": { "const": "quality_finding" } }
            }
          }
        }
      ]
    },
    "retrospective_envelope": {
      "allOf": [
        { "$ref": "#/$defs/journal_envelope" },
        {
          "properties": {
            "event": { "properties": { "action": { "const": "retrospective" } } }
          }
        }
      ]
    },
    "prohibition_envelope": {
      "allOf": [
        { "$ref": "#/$defs/journal_envelope" },
        {
          "properties": {
            "event": {
              "properties": { "action": { "const": "prohibition_check" } }
            }
          }
        }
      ]
    }
  }
}
