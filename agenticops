#!/usr/bin/env bash
set -euo pipefail

script_path="$(python3 -c 'from pathlib import Path; import sys; print(Path(sys.argv[1]).resolve())' "$0")"
product_root="$(CDPATH= cd -- "$(dirname -- "$script_path")" && pwd -P)"

usage() {
  cat <<'EOF'
用法：
  agenticops install [install 参数]
  agenticops setup
  agenticops agents
  agenticops station <init|doctor|repair|start|list|identity|prune|clean|detach|purge> [参数]
  agenticops update
  agenticops rollback

工作面：
  维护：源码产品根目录，setup 初始化，update 更新已记录的 develop
  使用：安装产品根目录，update/rollback 跟随安装时记录的分支
EOF
}

station="$(pwd -P)"
parse_station() {
  forwarded=()
  forwarded_count=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --station)
        test "$#" -ge 2 || { usage >&2; exit 2; }
        station="$2"
        shift 2
        ;;
      --)
        shift
        forwarded+=("$@")
        forwarded_count=$((forwarded_count + $#))
        break
        ;;
      *)
        forwarded+=("$1")
        forwarded_count=$((forwarded_count + 1))
        shift
        ;;
    esac
  done
}

start_agent() {
  agent_name=""
  agent_bound=0
  forwarded=()
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --station)
        test "$#" -ge 2 || { usage >&2; exit 2; }
        station="$2"
        shift 2
        ;;
      --agent)
        test "$#" -ge 2 || { usage >&2; exit 2; }
        test "$agent_bound" -eq 0 || { printf 'AgenticOps：start 重复指定 Agent ID\n' >&2; exit 2; }
        agent_name="$2"
        agent_bound=1
        shift 2
        ;;
      --)
        shift
        forwarded+=("$@")
        break
        ;;
      -*)
        printf 'AgenticOps：未知 start 参数：%s\n' "$1" >&2
        usage >&2
        exit 2
        ;;
      *)
        if [ "$agent_bound" -eq 0 ]; then
          agent_name="$1"
          agent_bound=1
        else
          printf 'AgenticOps：start 位置参数过多：%s\n' "$1" >&2
          usage >&2
          exit 2
        fi
        shift
        ;;
    esac
  done
  test -n "$agent_name" || { printf 'AgenticOps：start 缺少 Agent ID\n' >&2; exit 2; }
  python3 "$product_root/bootstrap/render.py" \
    --install-home "$product_root" --station "$station" --refresh
  python3 "$product_root/bootstrap/station_registry.py" \
    --product-root "$product_root" register --station "$station"
  agent_command="$(python3 "$product_root/bootstrap/agent_registry.py" \
    --product-root "$product_root" resolve-launch "$agent_name" --station "$station")"
  command -v "$agent_command" >/dev/null 2>&1 || {
    printf 'AgenticOps：未找到 Agent 命令：%s\n' "$agent_command" >&2
    exit 2
  }
  cd "$station"
  exec "$agent_command" ${forwarded[@]+"${forwarded[@]}"}
}

station_registry_command() {
  station_command_name="${1:-}"
  case "$station_command_name" in
    identity|prune|repair|clean|detach|purge)
      ;;
    *)
      exec python3 "$product_root/bootstrap/station_registry.py" \
        --product-root "$product_root" "$@"
      ;;
  esac

  station_target_supplied=0
  for station_argument in "$@"; do
    case "$station_argument" in
      --station|--all)
        station_target_supplied=1
        break
        ;;
    esac
  done
  if [ "$station_target_supplied" -eq 0 ]; then
    exec python3 "$product_root/bootstrap/station_registry.py" \
      --product-root "$product_root" "$station_command_name" --station "$station" "${@:2}"
  fi
  exec python3 "$product_root/bootstrap/station_registry.py" \
    --product-root "$product_root" "$@"
}

command_name="${1:-}"
if [ -z "$command_name" ]; then
  usage
  exit 2
fi
shift

station_scope=0
if [ "$command_name" = "station" ]; then
  station_scope=1
  command_name="${1:-}"
  test -n "$command_name" || { usage >&2; exit 2; }
  shift
  case "$command_name" in
    list|identity|prune|clean|detach|purge)
      station_registry_command "$command_name" "$@"
      ;;
    repair)
      for station_argument in "$@"; do
        if [ "$station_argument" = "--all" ]; then
          station_registry_command repair "$@"
        fi
      done
      ;;
  esac
fi

case "$command_name" in
  install)
    exec bash "$product_root/bootstrap/install.sh" "$@"
    ;;
  setup)
    exec env AGENTIC_OPS_HOME="$product_root" bash "$product_root/bootstrap/setup.sh" "$@"
    ;;
  agents)
    test "$#" -eq 0 || { usage >&2; exit 2; }
    exec python3 "$product_root/bootstrap/agent_registry.py" --product-root "$product_root" list
    ;;
  init)
    test "$station_scope" -eq 1 || { usage >&2; exit 2; }
    parse_station "$@"
    exec env AGENTIC_OPS_HOME="$product_root" \
      bash "$product_root/bootstrap/station-init.sh" \
        --station "$station" ${forwarded[@]+"${forwarded[@]}"}
    ;;
  doctor)
    test "$station_scope" -eq 1 || { usage >&2; exit 2; }
    parse_station "$@"
    test "$forwarded_count" -eq 0 || { usage >&2; exit 2; }
    station_resolved="$(python3 -c 'from pathlib import Path; import sys; print(Path(sys.argv[1]).resolve())' "$station")"
    if [ "$station_resolved" = "$product_root" ] && [ -f "$product_root/.agentic-ops-source" ]; then
      exec python3 "$product_root/bootstrap/skill_wiring.py" \
        --product-root "$product_root" --check
    fi
    exec python3 "$product_root/bootstrap/render.py" \
      --install-home "$product_root" --station "$station" --check
    ;;
  repair)
    test "$station_scope" -eq 1 || { usage >&2; exit 2; }
    parse_station "$@"
    repair_args=(--install-home "$product_root" --station "$station" --refresh)
    ensure_wiki=0
    if [ "$forwarded_count" -ne 0 ]; then
      for argument in "${forwarded[@]}"; do
        case "$argument" in
          --accept-checkpoint-migration) repair_args+=(--accept-checkpoint-migration) ;;
          --ensure-wiki) ensure_wiki=1 ;;
          *) usage >&2; exit 2 ;;
        esac
      done
    fi
    python3 "$product_root/bootstrap/render.py" "${repair_args[@]}"
    python3 "$product_root/bootstrap/station_registry.py" \
      --product-root "$product_root" register --station "$station"
    if [ "$ensure_wiki" -eq 1 ]; then
      python3 "$product_root/bootstrap/station_registry.py" \
        --product-root "$product_root" ensure-wiki --station "$station"
    fi
    exec python3 - "$product_root" "$station" <<'PY'
import sys
sys.path.insert(0, sys.argv[1])
from workflow import task_store
task_store.read_current(sys.argv[2])
print("AgenticOps 工位修复完成：%s" % sys.argv[2])
PY
    ;;
  start)
    test "$station_scope" -eq 1 || { usage >&2; exit 2; }
    start_agent "$@"
    ;;
  update)
    test "$#" -eq 0 || { usage >&2; exit 2; }
    exec env AGENTIC_OPS_HOME="$product_root" bash "$product_root/bootstrap/update.sh"
    ;;
  rollback)
    test "$#" -eq 0 || { usage >&2; exit 2; }
    mode="$(python3 "$product_root/bootstrap/product_state.py" --product-root "$product_root" read --field mode 2>/dev/null || true)"
    test "$mode" = "installed" || {
      printf 'AgenticOps：源码维护面不执行 rollback，请使用 Git 流程\n' >&2
      exit 2
    }
    exec env AGENTIC_OPS_HOME="$product_root" bash "$product_root/bootstrap/rollback.sh"
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    printf 'AgenticOps：未知命令：%s\n' "$command_name" >&2
    usage >&2
    exit 2
    ;;
esac
