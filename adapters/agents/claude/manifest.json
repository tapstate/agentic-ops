{
  "schema_version": 1,
  "name": "claude",
  "adapter_version": 1,
  "entrypoint": "adapters/agents/claude/hook.py",
  "capabilities": {
    "decisions": ["allow", "ask", "deny"],
    "ask_fallback": "native",
    "task_directory_argument": "--add-dir"
  },
  "artifacts": [
    {
      "template": "adapters/agents/claude/templates/CLAUDE.md",
      "target": "CLAUDE.md"
    },
    {
      "template": "adapters/agents/claude/templates/settings.json",
      "target": ".claude/settings.json"
    }
  ],
  "launch": {
    "mode": "command",
    "command": "claude",
    "message": "Claude 接线已生成。"
  },
  "project_skill_target": null
}
