{
  "schema_version": 1,
  "name": "codex",
  "adapter_version": 1,
  "entrypoint": "adapters/agents/codex/hook.py",
  "capabilities": {
    "decisions": ["allow", "deny"],
    "ask_fallback": "deny_with_guidance"
  },
  "artifacts": [
    {
      "template": "adapters/agents/codex/templates/hooks.example.json",
      "target": ".codex/agenticops-hooks.example.json"
    }
  ],
  "launch": {
    "mode": "command",
    "command": "codex",
    "message": "请按当前 Codex 版本支持的 Hook 配置加载生成的接线文件。"
  },
  "project_skill_target": null
}
