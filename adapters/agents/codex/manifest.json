{
  "schema_version": 2,
  "name": "codex",
  "adapter_version": 8,
  "entrypoint": "adapters/agents/codex/hook.py",
  "hook": {
    "standard_event": "before_operation",
    "tool_kinds": ["shell", "mcp"],
    "timeout_seconds": 30,
    "failure_mode": "deny",
    "native": {
      "event": "PreToolUse",
      "tool_matchers": null
    }
  },
  "capabilities": {
    "decisions": ["allow", "deny"],
    "ask_fallback": "deny_with_guidance"
  },
  "artifacts": [
    {
      "template": "adapters/agents/codex/templates/hooks.json",
      "target": ".codex/hooks.json"
    }
  ],
  "launch": {
    "mode": "command",
    "command": "codex",
    "message": "已生成 Codex 项目级 Hook 接线；首次启动时请在 /hooks 审核并信任。"
  },
  "skill_target": ".agents/skills"
}
