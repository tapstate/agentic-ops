{
  "schema_version": 1,
  "repository_target_operations": [
    "create_pr",
    "update_pr",
    "git_push",
    "fix_pr_comments",
    "create_repository"
  ],
  "jira_target_operations": [
    "write_jira_comment",
    "transition_jira_status",
    "write_jira_worklog",
    "edit_jira_issue"
  ],
  "shell": {
    "dangerous_environment_names": [
      "ALL_PROXY", "BASH_ENV", "CURL_CA_BUNDLE", "ENV", "HOME", "HTTPS_PROXY",
      "HTTP_PROXY", "IFS", "NO_PROXY", "PATH", "PERL5LIB", "PYTHONHOME", "PYTHONPATH",
      "RIPGREP_CONFIG_PATH",
      "RUBYLIB", "SSL_CERT_DIR", "SSL_CERT_FILE", "XDG_CONFIG_HOME", "all_proxy",
      "http_proxy", "https_proxy", "no_proxy"
    ],
    "dangerous_environment_prefixes": ["DYLD_", "GIT_", "LD_", "SSH_"],
    "git_readonly_redirects": ["status", "rev-parse", "diff", "log", "show"],
    "git_push_allowed_flags": [
      "--dry-run", "--force", "--force-with-lease", "--ipv4", "--ipv6",
      "--porcelain", "--progress", "--quiet", "--set-upstream", "--verbose"
    ],
    "git_push_allowed_short_flags": "fuvqn46",
    "git_push_unsafe_value_options": [
      "-o", "--exec", "--push-option", "--receive-pack", "--repo", "--server-option"
    ],
    "code_executors": {
      "node": {
        "names": ["node", "nodejs"], "versioned": true
      },
      "perl": {
        "names": ["perl"], "versioned": true
      },
      "python": {
        "names": ["python"], "versioned": true
      },
      "ruby": {
        "names": ["ruby"], "versioned": true
      }
    },
    "git_simple_operations": {
      "clean": "git_clean",
      "merge": "git_merge",
      "rebase": "git_rebase"
    },
    "gh_pr_operations": {
      "close": "update_pr",
      "comment": "fix_pr_comments",
      "create": "create_pr",
      "edit": "update_pr",
      "merge": "pr_merge",
      "ready": "update_pr",
      "reopen": "update_pr",
      "review": "fix_pr_comments",
      "update-branch": "update_pr"
    },
    "workflow_modules": {
      "workflow.repository_worktree": "repository_worktree.py",
      "workflow.task": "task.py"
    }
  },
  "mappings": {
    "github": {
      "create_pull_request": "create_pr",
      "update_pull_request": "update_pr",
      "update_pull_request_branch": "update_pr",
      "merge_pull_request": "pr_merge",
      "push_files": "git_push",
      "create_or_update_file": "git_push",
      "delete_file": "git_push",
      "create_repository": "create_repository",
      "fork_repository": "create_repository",
      "add_reply_to_pull_request_comment": "fix_pr_comments",
      "pull_request_review_write": "fix_pr_comments",
      "add_comment_to_pending_review": "fix_pr_comments"
    },
    "atlassian": {
      "transition_issue": "transition_jira_status",
      "transitionjiraissue": "transition_jira_status",
      "add_comment": "write_jira_comment",
      "addcommenttojiraissue": "write_jira_comment",
      "add_issue_comment": "write_jira_comment",
      "edit_issue": "edit_jira_issue",
      "editjiraissue": "edit_jira_issue",
      "update_issue": "edit_jira_issue",
      "issue_write": "edit_jira_issue",
      "create_issue": "edit_jira_issue",
      "createjiraissue": "edit_jira_issue",
      "add_worklog": "write_jira_worklog",
      "addworklogtojiraissue": "write_jira_worklog"
    }
  }
