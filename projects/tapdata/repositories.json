{
  "schema_version": 1,
  "default": "tapdata/tapdata",
  "layout": {
    "main_worktree": "<pool>/<owner>/<repo>",
    "task_worktree": "<workspace>/.agenticops/worktrees/<issue-key>/<run-id>/<owner>/<repo>"
  },
  "repositories": {
    "tapdata/tapdata": {"origin": "git@github.com:tapdata/tapdata.git", "baseline_branch": "develop", "dev_branch": "develop", "domains": ["product"]},
    "tapdata/tapdata-common-lib": {"origin": "git@github.com:tapdata/tapdata-common-lib.git", "baseline_branch": "develop", "dev_branch": "develop", "domains": ["product"]},
    "tapdata/tapdata-connectors": {"origin": "git@github.com:tapdata/tapdata-connectors.git", "baseline_branch": "develop", "dev_branch": "develop", "domains": ["product"]},
    "tapdata/tapdata-connectors-enterprise": {"origin": "git@github.com:tapdata/tapdata-connectors-enterprise.git", "baseline_branch": "develop", "dev_branch": "develop", "domains": ["product"]},
    "tapdata/tapdata-enterprise": {"origin": "git@github.com:tapdata/tapdata-enterprise.git", "baseline_branch": "develop", "dev_branch": "develop", "domains": ["product"]},
    "tapdata/tapdata-license": {"origin": "git@github.com:tapdata/tapdata-license.git", "baseline_branch": "main", "dev_branch": "main", "domains": ["product"]},
    "tapdata/tapdata-web": {"origin": "git@github.com:tapdata/tapdata-web.git", "baseline_branch": "develop", "dev_branch": "develop", "domains": ["product"]},
    "tapdata/hazelcast": {"origin": "git@github.com:tapdata/hazelcast.git", "baseline_branch": "release-v5.5.0", "dev_branch": "release-v5.5.0", "domains": []},
    "tapdata/tapdata-application": {"origin": "git@github.com:tapdata/tapdata-application.git", "baseline_branch": "main", "dev_branch": "main", "domains": ["product"]},
    "tapdata/t-layer3-test": {"origin": "git@github.com:tapdata/t-layer3-test.git", "baseline_branch": "develop", "dev_branch": "develop", "domains": ["taptest"]},
    "tapdata/docs": {"origin": "git@github.com:tapdata/docs.git", "baseline_branch": "main", "dev_branch": "main", "domains": []},
    "tapdata/docs-en": {"origin": "git@github.com:tapdata/docs-en.git", "baseline_branch": "main", "dev_branch": "main", "domains": []}
  },
  "branch_resolution": {
    "rule": "任务基线必须按目标仓库从 repositories 显式解析；禁止从当前分支或隐式 main 猜测",
    "resolver": "python3 workflow/task.py branch --repo <owner/repo>",
    "forbidden_sources": ["current_branch", "implicit_main", "runbook_example"],
    "on_unknown_repository": "解析器 exit 2 并停止；先在本目录补齐仓库定义，不得推测"
  }
}
