{
  "_meta": {
    "source": "AgenticOps TapData 项目适配配置",
    "ported_at": "2026-08-27",
    "note": "transitions 为 tapdata Jira 真实工作流实测（2026-08-18）；未配流转按需补充"
  },
  "profile_id": "tapdata",
  "jira": {
    "site": "https://tapdata.atlassian.net",
    "project_key": "TAP",
    "issue_types": ["Story", "故事", "Bug", "缺陷", "Task", "任务"],
    "task_query": "project = TAP AND assignee = currentUser() AND statusCategory != Done ORDER BY updated DESC",
    "description_sections": [
      "问题分支", "问题版本", "问题现象", "复现路径", "验收标准", "仓库分支"
    ],
    "custom_fields": {
      "issue_analysis": "customfield_10092",
      "fix_details": "customfield_10093",
      "verification_method": "customfield_10049"
    }
  },
  "repositories": {
    "default": "tapdata/tapdata",
    "worktree_domains": {
      "product": {
        "baseline_repository": "tapdata/tapdata",
        "repositories": [
          "tapdata/tapdata", "tapdata/tapdata-enterprise", "tapdata/tapdata-web",
          "tapdata/tapdata-license", "tapdata/tapdata-common-lib",
          "tapdata/tapdata-application", "tapdata/tapdata-connectors",
          "tapdata/tapdata-connectors-enterprise"
        ]
      },
      "assistant": {
        "baseline_repository": "tapdata/feishu_robot",
        "repositories": ["tapdata/feishu_robot"]
      },
      "taptest": {
        "baseline_repository": "tapdata/t-layer3-test",
        "repositories": ["tapdata/t-layer3-test"]
      }
    },
    "baseline_branches": {
      "tapdata/tapdata": "develop",
      "tapdata/tapdata-enterprise": "develop",
      "tapdata/tapdata-web": "develop",
      "tapdata/tapdata-connectors": "develop",
      "tapdata/tapdata-connectors-enterprise": "develop",
      "tapdata/tapdata-license": "main",
      "tapdata/tapdata-common-lib": "develop",
      "tapdata/tapdata-application": "main",
      "tapdata/feishu_robot": "master",
      "tapdata/t-layer3-test": "develop"
    },
    "dev_branches": {
      "tapdata/tapdata": "develop",
      "tapdata/tapdata-cloud": "develop",
      "tapdata/tapdata-common-lib": "develop",
      "tapdata/tapdata-connectors": "develop",
      "tapdata/tapdata-connectors-enterprise": "develop",
      "tapdata/tapdata-enterprise": "develop",
      "tapdata/tapdata-license": "main",
      "tapdata/tapdata-web": "develop",
      "tapdata/hazelcast": "release-v5.5.0",
      "tapdata/tapdata-application": "main",
      "tapdata/feishu_robot": "master",
      "tapdata/t-layer3-test": "develop",
      "tapdata/docs": "main",
      "tapdata/docs-en": "main",
      "tapdata/mcp-tap-server": "main",
      "tapdata/solutions": "main",
      "tapdata/fhir-solution": "main"
    },
    "branch_resolution": {
      "rule": "任务基线必须按目标仓库从 baseline_branches 显式解析；禁止从当前分支或隐式 main 猜测",
      "resolver": "python3 workflow/task.py branch --repo <owner/repo>",
      "forbidden_sources": ["current_branch", "implicit_main", "runbook_example"],
      "on_unknown_repository": "解析器 exit 2 并停止；先在本文件补齐分支映射，不得推测"
    }
  },
  "statuses": {
    "打开": "waiting_takeover", "待办": "waiting_takeover", "To Do": "waiting_takeover",
    "On Hold": "waiting_takeover",
    "正在进行": "implementation", "In Progress": "implementation",
    "Pull Request Submitted": "implementation", "Tests Passed": "implementation",
    "完成": "completed", "Done": "completed"
  },
  "transitions": {
    "start_progress": { "name": "Implementation started", "id": "91", "from": ["打开"], "to": "正在进行" },
    "pr_approved": { "name": "PR Approved", "id": "291", "from": ["Pull Request Submitted"], "to": "Merged", "agent_forbidden": true }
  }
}
