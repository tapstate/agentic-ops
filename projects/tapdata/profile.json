    "project_key": "TAP",
    "issue_types": ["Story", "故事", "Bug", "缺陷", "Task", "任务"],
    "task_query": "project = TAP AND assignee = currentUser() AND statusCategory != Done ORDER BY updated DESC",
    "description_sections": [
      "问题分支", "问题版本", "问题现象", "复现路径", "验收标准", "仓库分支"
    ],
    "custom_fields": {
      "issue_analysis": "customfield_10092",
      "fix_details": "customfield_10093",
      "verification_method": "customfield_10049"
    }
  },
  "repositories": {"catalog": "repositories.json"},
  "statuses": {
    "Analyzed": "waiting_takeover",
    "正在进行": "implementation", "In Progress": "implementation",
    "Pull Request Submitted": "implementation", "Tests Passed": "implementation",
    "完成": "completed", "Done": "completed"
  },
  "transitions": {
    "start_progress": { "name": "Start Investigation", "id": "421", "from": ["Analyzed"], "to": "In Progress" },
    "pr_approved": { "name": "PR Approved", "id": "291", "from": ["Pull Request Submitted"], "to": "Merged", "agent_forbidden": true }
  },
  "workflows_by_issue_type": [
    {
      "issue_type": { "id": "10008", "name": "任务" },
      "statuses": [
        { "id": "10029", "name": "待办", "stage": "waiting_takeover" },
        { "id": "3", "name": "正在进行", "stage": "implementation" }
      ],
      "transitions": {
        "start_progress": {
          "name": "Work started",
          "id": "61",
          "from": { "id": "10029", "name": "待办" },
          "to": { "id": "3", "name": "正在进行" }
        }
      }
    }
  ]
