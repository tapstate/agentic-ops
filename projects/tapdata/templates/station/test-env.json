{
  "schema_version": 1,
  "nodes": {"node1": ["TM", "FE", "APIServer"]},
  "image": "eclipse-temurin:17-jre-jammy",
  "platform": "",
  "mongo_uri_file": "mongodb-uri",
  "mongo_driver": "tapdata/tapdata-enterprise/tapdata-agent/node_modules",
