{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenticops.tapdata.net/contracts/station-state-compatibility.schema.json",
  "title": "AgenticOps Station State Compatibility",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "minimum_updater_protocol_version",
    "station_state_epoch",
    "legacy_station_state_epoch",
    "supported_station_state_epochs"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "minimum_updater_protocol_version": { "type": "integer", "minimum": 1 },
    "station_state_epoch": { "type": "integer", "minimum": 1 },
    "legacy_station_state_epoch": { "type": "integer", "minimum": 1 },
    "supported_station_state_epochs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 1 }
    }
  }
}
