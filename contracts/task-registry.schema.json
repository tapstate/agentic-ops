{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenticops.tapdata.net/contracts/task-registry-v1.schema.json",
  "title": "AgenticOps Project Workspace Task Registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project", "tasks"],
  "properties": {
    "schema_version": { "const": 1 },
    "project": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "tasks": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "created_at", "updated_at"],
        "properties": {
          "status": { "enum": ["active", "inactive", "completed"] },
          "created_at": { "type": "string", "minLength": 1 },
          "updated_at": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
