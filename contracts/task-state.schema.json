{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenticops.tapdata.net/contracts/current-task-v1.schema.json",
  "title": "AgenticOps 单任务工位当前状态",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "revision", "current"],
  "properties": {
    "schema_version": {"const": 1},
    "revision": {"type": "integer", "minimum": 0},
    "current": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["issue_key", "run_id", "task_class", "stage", "outcome", "facts", "history", "pending", "engineering_baseline", "task_repositories", "terminal_proof", "archive_ref"],
      "properties": {
        "issue_key": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*-[1-9][0-9]*$"},
        "run_id": {"type": "string", "pattern": "^(?:run-[a-z0-9][a-z0-9-]*|[A-Z][A-Z0-9_]*-[1-9][0-9]*-[0-9a-f]{8}(?:-[0-9a-f]{8})?)$"},
        "task_class": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "stage": {"enum": ["waiting_takeover", "task_intake", "design_review", "implementation", "pr_review", "ci_validation", "completed"]},
        "outcome": {"enum": ["in_progress", "completed", "interrupted"]},
        "facts": {"type": "object"},
        "history": {"type": "array", "items": {"type": "object"}},
        "pending": {"type": ["object", "null"]},
        "reset_baseline": {"type": "object"},
        "replan": {"type": "object"},
        "replan_preserved": {"type": "object"},
        "retained_repositories": {"type": "object"},
        "initial_runtime": {"$ref": "station-directory.schema.json"},
        "source_prepared": {"type": "boolean"},
        "engineering_baseline": {
          "type": "object", "required": ["status"],
          "properties": {"status": {"enum": ["resolving", "frozen"]}},
          "description": "冻结值另须通过 engineering-baseline.schema.json 及 engineering_baseline.validate 核验。"
        },
        "task_repositories": {
          "type": "object",
          "additionalProperties": {
            "type": "object", "additionalProperties": false,
            "required": ["repository_id", "baseline_entry_digest", "work_branch", "target_branch", "approved_scope", "verification_method", "observation", "deliveries", "disposition"],
            "properties": {
              "repository_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
              "baseline_entry_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "work_branch": {"type": "string", "minLength": 1},
              "target_branch": {"type": "string", "minLength": 1},
              "approved_scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
              "verification_method": {"type": "string", "minLength": 1},
              "observation": {"type": ["object", "null"]},
              "deliveries": {"type": "array", "items": {"type": "object"}},
              "disposition": {"type": "string", "minLength": 1}
            }
          }
        },
        "terminal_proof": {"type": ["object", "null"]},
        "archive_ref": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["scope", "run_id", "digest"],
          "properties": {
            "scope": {"const": "product"},
            "run_id": {"type": "string", "pattern": "^(?:run-[a-z0-9][a-z0-9-]*|[A-Z][A-Z0-9_]*-[1-9][0-9]*-[0-9a-f]{8}(?:-[0-9a-f]{8})?)$"},
            "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
          }
        }
      }
    }
  }
}
