{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenticops.tapdata.net/contracts/task-state-v1.schema.json",
  "title": "AgenticOps Normalized Task State v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "issue_key", "task_class", "stage", "facts", "repositories", "pending", "history"
  ],
  "properties": {
    "issue_key": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*-[1-9][0-9]*$" },
    "task_class": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "stage": {
      "enum": [
        "waiting_takeover", "task_intake", "design_review", "implementation",
        "pr_review", "ci_validation", "completed"
      ]
    },
    "facts": { "type": "object" },
    "repositories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repository", "work_branch", "base_branch", "approved_scope",
          "verification_method", "pull_request", "ci"
        ],
        "properties": {
          "repository": { "type": "string", "minLength": 1 },
          "work_branch": { "type": "string", "minLength": 1 },
          "base_branch": { "type": "string", "minLength": 1 },
          "approved_scope": { "type": "string", "minLength": 1 },
          "verification_method": { "type": "string", "minLength": 1 },
          "pull_request": { "type": ["string", "null"] },
          "ci": { "type": ["string", "null"] }
        }
      }
    },
    "pending": { "type": ["object", "null"] },
    "history": { "type": "array", "items": { "type": "object" } }
  }
}
