{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenticops.tapdata.net/contracts/workspace-v2.schema.json",
  "title": "AgenticOps Project Workspace Configuration v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "product_root", "workspace_id", "project", "agents", "repository_pool"],
  "properties": {
    "schema_version": { "const": 2 },
    "product_root": { "type": "string", "minLength": 1 },
    "workspace_id": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
    "project": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "agents": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
    },
    "repository_pool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "source"],
      "properties": {
        "root": { "type": "string", "minLength": 1 },
        "source": { "enum": ["product-default", "workspace-override", "product-default-migration"] }
      }
    }
  }
}
