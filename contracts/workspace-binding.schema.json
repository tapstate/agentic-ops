{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenticops.tapdata.net/contracts/workspace-binding-v1.schema.json",
  "title": "AgenticOps Workspace Binding v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product_root",
    "product_ref",
    "project",
    "agents",
    "generated_artifacts"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "product_root": { "type": "string", "minLength": 1 },
    "product_ref": { "type": "string", "minLength": 1 },
    "project": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "agents": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["claude", "codex"] }
    },
    "generated_artifacts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
