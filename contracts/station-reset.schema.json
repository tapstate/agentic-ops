{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenticops.tapdata.net/contracts/station-reset.schema.json",
  "title": "生命周期整区清理计划",
  "type": "object",
  "required": [
    "schema_version",
    "scope",
    "revision",
    "run_id",
    "config",
    "targets",
    "source",
    "digest"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 8
    },
    "scope": {
      "enum": [
        "task",
        "station"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "config": {
      "type": "object"
    },
    "targets": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "path",
          "parent",
          "snapshot",
          "recreate"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "parent": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "minItems": 3
          },
          "snapshot": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "identity",
                  "digest"
                ],
                "additionalProperties": false,
                "properties": {
                  "identity": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    },
                    "minItems": 3
                  },
                  "digest": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              }
            ]
          },
          "recreate": {
            "type": "boolean"
          }
        }
      }
    },
    "source": {
      "type": "object"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
