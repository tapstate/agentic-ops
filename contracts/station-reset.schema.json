{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenticops.tapdata.net/contracts/station-reset.schema.json",
  "title": "清单清理计划",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "config",
    "objects",
    "retained",
    "residuals",
    "digest",
    "protected_paths"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 7
    },
    "run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "config": {
      "type": "object"
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "identity",
          "parent",
          "repository",
          "relative",
          "type"
        ]
      }
    },
    "retained": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "residuals": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "protected_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
