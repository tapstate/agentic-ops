{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "工位重置确认清单版本 6（规则快照另由读取器校验）",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "directories",
    "entries",
    "source",
    "external",
    "active_state",
    "retained",
    "digest",
    "archive_runtime",
    "rules"
  ],
  "properties": {
    "rules": {
      "type": "object",
      "required": [
        "digests",
        "objects"
      ],
      "additionalProperties": false,
      "properties": {
        "digests": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "const": null
              },
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            ]
          }
        },
        "objects": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "action",
              "layer"
            ],
            "additionalProperties": false,
            "properties": {
              "action": {
                "enum": [
                  "preserve",
                  "source-reset",
                  "clear-children",
                  "lifecycle-clean",
                  "remove"
                ]
              },
              "layer": {
                "enum": [
                  "central",
                  "project"
                ]
              }
            }
          }
        }
      }
    },
    "schema_version": {
      "const": 6
    },
    "run_id": {
      "type": "string",
      "pattern": "^(?:run-[a-z0-9][a-z0-9-]*|[A-Z][A-Z0-9_]*-[1-9][0-9]*-[0-9a-f]{8}(?:-[0-9a-f]{8})?)$"
    },
    "directories": {
      "type": "array",
      "items": {
        "$ref": "station-directory.schema.json"
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "repository",
          "file",
          "action",
          "head",
          "before",
          "before_index",
          "index_patch",
          "worktree_patch",
          "preservation"
        ],
        "properties": {
          "action": {
            "enum": [
              "restore",
              "delete"
            ]
          },
          "preservation": {
            "type": "object",
            "required": [
              "action"
            ],
            "properties": {
              "action": {
                "enum": [
                  "archive",
                  "export",
                  "discard"
                ]
              }
            }
          }
        }
      }
    },
    "source": {
      "type": "object"
    },
    "external": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "action"
        ]
      }
    },
    "active_state": {
      "type": "object",
      "required": [
        "files",
        "unbind_run",
        "task_digest"
      ]
    },
    "retained": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "archive_runtime": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
