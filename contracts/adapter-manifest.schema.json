{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenticops.tapdata.net/contracts/adapter-manifest-v3.schema.json",
  "title": "AgenticOps Agent Adapter Manifest v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "adapter_version", "artifacts", "launch"],
  "properties": {
    "schema_version": { "const": 3 },
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "adapter_version": { "type": "integer", "minimum": 1 },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["template", "target"],
        "properties": {
          "template": { "type": "string", "minLength": 1 },
          "target": { "type": "string", "minLength": 1 }
        }
      }
    },
    "retired_artifacts": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "launch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "command", "message"],
      "properties": {
        "mode": { "enum": ["command", "manual"] },
        "command": { "type": ["string", "null"] },
        "message": { "type": "string" }
      }
    },
    "skill_target": { "type": ["string", "null"] }
  }
}
