#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
zero_sha="0000000000000000000000000000000000000000"

if ! git diff --quiet -- \
  .githooks internal/bin/story-gate internal/pyproject.toml internal/uv.lock \
  internal/story_gate; then
  echo "story gate implementation has uncommitted changes" >&2
  exit 1
fi

while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$local_sha" = "$zero_sha" ] && [ "${AGENTIC_OPS_SPECIAL_PUSH:-}" != "history-rewrite" ]; then
    case "$remote_ref" in
      refs/heads/main|refs/heads/develop|refs/heads/release/*)
        echo "branch_deletion_prohibited: main、develop 和 release/* 分支不可删除" >&2
        exit 1
        ;;
    esac
  fi
  if [ "$remote_ref" = "refs/heads/main" ] &&
    [ "${AGENTIC_OPS_SPECIAL_PUSH:-}" != "hotfix" ] &&
    [ "${AGENTIC_OPS_SPECIAL_PUSH:-}" != "history-rewrite" ]; then
    echo "direct push to main is prohibited; use a pull request" >&2
    exit 1
  fi
  if [ "$local_sha" = "$zero_sha" ]; then continue; fi

  case "${AGENTIC_OPS_SPECIAL_PUSH:-}" in
    hotfix)
      case "$remote_ref" in refs/heads/main|refs/heads/develop) continue;; esac
      echo "hotfix_push_target_invalid" >&2
      exit 1
      ;;
    history-rewrite)
      case "$remote_ref" in refs/heads/main|refs/heads/develop|refs/heads/release/*|refs/tags/v*) continue;; esac
      echo "history_rewrite_push_target_invalid" >&2
      exit 1
      ;;
    release)
      continue
      ;;
  esac

  case "$local_ref" in
    refs/heads/*) branch="${local_ref#refs/heads/}" ;;
    refs/tags/*)
      echo "story_review_channel_protected: tags require the versioned release workflow" >&2
      exit 1
      ;;
    *)
      echo "story_review_branch_unknown: only named branch pushes are supported" >&2
      exit 1
      ;;
  esac

  AGENTIC_OPS_STORY_BRANCH="$branch" \
    AGENTIC_OPS_STORY_GATE_STAGE=pre_push \
    PYTHONDONTWRITEBYTECODE=1 \
    "$repo_root/internal/bin/story-gate" \
      impact --change-source range --head "$local_sha"
done
