#!/usr/bin/env bash
set -euo pipefail

branch="$(git branch --show-current)"
if [ "$branch" = "main" ]; then
  echo "direct commit to main is prohibited; use develop or a task branch" >&2
  exit 1
fi
repo_root="$(git rev-parse --show-toplevel)"
marker_head="$(git show HEAD:.agentic-ops-source 2>/dev/null | sed -n '1p' || true)"
marker_index="$(git show :.agentic-ops-source 2>/dev/null | sed -n '1p' || true)"
marker_worktree="$(sed -n '1p' "$repo_root/.agentic-ops-source" 2>/dev/null || true)"

if [ "$marker_head" = "source" ] || [ "$marker_index" = "source" ] || [ "$marker_worktree" = "source" ]; then
  if [ "$marker_index" != "source" ]; then
    echo "AgenticOps source marker is missing or invalid in the staged snapshot" >&2
    exit 1
  fi
  for required_path in \
    .githooks/pre-commit .githooks/pre-push .githooks/reference-transaction \
    internal/bin/story-gate internal/story_gate/review-policy.yaml \
    internal/story_gate/stories.yaml; do
    git cat-file -e ":$required_path" 2>/dev/null || {
      echo "AgenticOps required gate asset is missing from staged snapshot: $required_path" >&2
      exit 1
    }
  done

  governed_runtime=(
    .githooks internal/bin/story-gate internal/pyproject.toml internal/uv.lock
    internal/story_gate internal/tests docs/user-stories/v1
  )
  if ! git diff --quiet -- "${governed_runtime[@]}"; then
    echo "AgenticOps story gate or story contracts have unstaged changes" >&2
    exit 1
  fi

  AGENTIC_OPS_STORY_BRANCH="$branch" \
    AGENTIC_OPS_STORY_GATE_STAGE=pre_commit \
    PYTHONDONTWRITEBYTECODE=1 \
    "$repo_root/internal/bin/story-gate" \
      impact --change-source staged
fi
