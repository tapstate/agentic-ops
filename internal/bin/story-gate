#!/usr/bin/env bash
set -euo pipefail

script_dir="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)"
source_root="$(CDPATH= cd -- "$script_dir/../.." && pwd -P)"
python_bin="${AGENTIC_OPS_INTERNAL_PYTHON:-$source_root/internal/.venv/bin/python}"

if [ ! -x "$python_bin" ]; then
  python_bin="$(command -v python3)"
fi

PYTHONPATH="$source_root${PYTHONPATH:+:$PYTHONPATH}" \
  exec "$python_bin" -m internal.story_gate.cli --source-root "$source_root" "$@"
