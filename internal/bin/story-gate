#!/usr/bin/env bash
set -euo pipefail

script_dir="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)"
source_root="$(CDPATH= cd -- "$script_dir/../.." && pwd -P)"
. "$source_root/internal/python-environment.sh"
python_bin="${AGENTIC_OPS_INTERNAL_PYTHON:-$source_root/.local/venv/internal/bin/python}"

if [ ! -x "$python_bin" ]; then
  echo 'AgenticOps：内部 Python 3.12 环境缺失，请先准备维护环境' >&2
  exit 2
fi
"$python_bin" -I -c 'import sys; assert sys.version_info[:2] == (3, 12), "内部工具要求 Python 3.12.x"'

PYTHONPATH="$source_root${PYTHONPATH:+:$PYTHONPATH}" \
  exec "$python_bin" -m internal.story_gate.cli --source-root "$source_root" "$@"
